{
  "name": "cuvinte-game",
  "version": "1.0.0",
  "private": true,
  "description": "Romanian word game app",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "backend": "pnpm --filter backend dev",
    "frontend": "pnpm --filter frontend dev",
    "prod": "pnpm build && pm2 start ecosystem.config.cjs",
    "prod:stop": "pm2 stop cuvinte-backend",
    "prod:restart": "pnpm build && pm2 restart cuvinte-backend",
    "prod:logs": "pm2 logs cuvinte-backend"
  },
  "keywords": ["romanian", "word-game", "vue", "typescript"],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "pm2": "^5.3.0"
  }
}
